# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Data & generated artifacts (kept out of git; structure preserved via .gitkeep)
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

logs/*
!logs/.gitkeep

reports/*
!reports/.gitkeep

*.db
*.sqlite
*.sqlite3

# Notebooks checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
