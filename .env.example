# Copy this file to .env and fill in real values. Never commit .env.
#
# --- Safety flags -----------------------------------------------------
# Both must be explicitly "true" for any real order to be sent.
# Leaving either unset/false keeps the system in paper/dry-run mode.
LIVE_TRADING=false
LIVE_CONFIRMATION=false

# --- Database -----------------------------------------------------------
DATABASE_URL=sqlite:///data/quant_trader.db

# --- MetaTrader 5 (Windows-only runtime, see requirements-windows.txt) --
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# --- Generic REST/WebSocket broker --------------------------------------
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
